---
import SeoPage from "../../components/SeoPage.astro";

const faqs = [
  {
    question: "¿Puedo adquirir una televisión a crédito?",
    answer: "Sí. Puedes consultar opciones de televisiones a crédito, televisores a crédito y TV a crédito con un asesor de Creditek Ecuador.",
  },
  {
    question: "¿Ofrecen celulares y televisiones a crédito?",
    answer: "Sí. Creditek trabaja con opciones de celulares y televisiones a crédito para clientes que buscan tecnología en cuotas.",
  },
  {
    question: "¿Dónde puedo solicitar información?",
    answer: "Puedes escribir por WhatsApp o visitar una sucursal Creditek para conocer disponibilidad, requisitos y alternativas de pago.",
  },
  {
    question: "¿Qué significa comprar televisiones en cuotas?",
    answer: "Significa consultar una alternativa de pago distribuida en cuotas, sujeta a validación y a las condiciones informadas por Creditek.",
  },
];
---

<SeoPage
  title="Preguntas Frecuentes sobre Crédito | Creditek"
  description="Resuelve dudas sobre celulares y televisiones a crédito, requisitos, sucursales y opciones en cuotas con Creditek Ecuador."
  h1="Preguntas Frecuentes sobre Crédito"
  intro="Resuelve tus dudas sobre celulares y televisiones a crédito, televisores en cuotas, requisitos y atención en Creditek Ecuador."
  image="/Creditek/webp/creditek.webp"
  imageAlt="Creditek Ecuador preguntas frecuentes"
  faqs={faqs}
/>
