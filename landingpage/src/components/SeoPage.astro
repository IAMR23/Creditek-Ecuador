---
import Footer from "./Footer.astro";
import NavBar from "./NavBar.astro";
import Whatsapp from "./Whatsapp.astro";
import Layout from "../layouts/Layout.astro";

interface ContentItem {
  title: string;
  body: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  h1: string;
  intro: string;
  image?: string;
  imageAlt?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  points?: ContentItem[];
  faqs?: FaqItem[];
}

const {
  title,
  description,
  eyebrow = "Creditek Ecuador",
  h1,
  intro,
  image = "/Creditek/webp/landing.webp",
  imageAlt = "Productos Creditek Ecuador",
  ctaText = "Solicitar información",
  ctaHref = "https://api.whatsapp.com/send/?phone=593962749300&text=Hola%2C+me+gustar%C3%ADa+obtener+m%C3%A1s+informaci%C3%B3n.&type=phone_number&app_absent=0",
  secondaryText = "Ver sucursales",
  secondaryHref = "/sucursales/",
  points = [],
  faqs = [],
} = Astro.props;
---

<Layout title={title} description={description}>
  <NavBar />

  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-emerald-700 via-emerald-600 to-orange-500 pt-32 pb-20 text-white">
      <div class="absolute inset-0 bg-black/25"></div>
      <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-6 lg:grid-cols-[1fr_0.8fr]">
        <div>
          <p class="mb-4 text-sm font-bold uppercase text-orange-100">
            {eyebrow}
          </p>
          <h1 class="max-w-4xl text-4xl font-extrabold leading-tight md:text-5xl">
            {h1}
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-white/90">
            {intro}
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href={ctaHref}
              target={ctaHref.startsWith("http") ? "_blank" : undefined}
              class="rounded-lg bg-orange-500 px-6 py-3 text-center font-bold text-white shadow-lg transition hover:bg-orange-600"
            >
              {ctaText}
            </a>
            <a
              href={secondaryHref}
              class="rounded-lg border-2 border-white px-6 py-3 text-center font-bold text-white transition hover:bg-white hover:text-emerald-700"
            >
              {secondaryText}
            </a>
          </div>
        </div>

        <img
          src={image}
          alt={imageAlt}
          class="h-full max-h-[420px] w-full rounded-2xl object-cover shadow-2xl"
        />
      </div>
    </section>

    {
      points.length > 0 && (
        <section class="bg-white py-16">
          <div class="mx-auto max-w-7xl px-6">
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
              {points.map((point) => (
                <article class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                  <h2 class="text-xl font-extrabold text-gray-800">{point.title}</h2>
                  <p class="mt-3 leading-7 text-gray-600">{point.body}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <slot />

    {
      faqs.length > 0 && (
        <section class="bg-gray-50 py-16">
          <div class="mx-auto max-w-4xl px-6">
            <h2 class="text-3xl font-extrabold text-gray-800">Preguntas frecuentes</h2>
            <div class="mt-8 space-y-4">
              {faqs.map((faq) => (
                <article class="rounded-lg bg-white p-6 shadow-sm">
                  <h3 class="text-lg font-bold text-gray-800">{faq.question}</h3>
                  <p class="mt-2 leading-7 text-gray-600">{faq.answer}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>

  <Whatsapp />
  <Footer />
</Layout>
