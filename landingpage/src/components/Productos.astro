---
const items = [
  {
    type: "Producto",
    title: "Celulares a Crédito",
    desc: "Consulta celulares disponibles, alternativas de pago y la información necesaria para solicitar crédito.",
    icon: "📱",
  },
  {
    type: "Producto",
    title: "Televisores a Crédito",
    desc: "Consulta televisores para el hogar y las opciones de compra a crédito disponibles en Creditek.",
    icon: "📺",
  },
  {
    type: "Servicio",
    title: "Solicitud de Crédito",
    desc: "Completa la solicitud o consulta con un asesor para conocer el proceso y los requisitos aplicables.",
    icon: "⚡",
  },
  {
    type: "Servicio",
    title: "Asesoría Personalizada",
    desc: "Recibe información para comparar productos, requisitos y opciones disponibles antes de decidir.",
    icon: "🤝",
  },
];
---

<section id="productos-servicios" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Título -->
    <div class="text-center mb-14">
      <h2 class="text-4xl font-bold text-gray-800">
        Productos y Servicios
      </h2>
      <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
        Consulta celulares y televisores, conoce el proceso de solicitud y recibe
        información en nuestros canales de atención.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {items.map(item => (
        <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl 
                    transition-all duration-300 hover:-translate-y-2 border border-transparent 
                    hover:border-green-500">

          <!-- Icon -->
          <div class="text-5xl mb-4 transition-transform duration-300 
                      group-hover:scale-110">
            {item.icon}
          </div>

          <!-- Tipo -->
          <span class="inline-block mb-2 text-sm font-semibold 
                       text-green-600 bg-green-100 px-3 py-1 rounded-full">
            {item.type}
          </span>

          <!-- Título -->
          <h3 class="text-xl font-bold text-gray-800 mb-2 
                     group-hover:text-green-600 transition-colors">
            {item.title}
          </h3>

          <!-- Descripción -->
          <p class="text-gray-600 text-sm">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
