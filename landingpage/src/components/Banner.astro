---
import { FBURL, INS, TIKTOK } from "../const/constSocialNetworks";
---

<section class="hero">
  <div class="overlay"></div>

  <div class="hero-content">
    <!-- IZQUIERDA -->
    <div class="hero-text">
      <h1>Celulares y <span>televisores</span> a crédito </h1>

      <p class="subtitle">
        Envios a <span>Quito</span> y toda la <span> Sierra Ecuatoriana</span>. Conoce el proceso de solicitud y recibe información en nuestros canales de atención.
      </p>

      <div class="hero-buttons">
        <a href="/trabaja-con-nosotros" class="btn btn-primary"> Trabaja con nosotros </a>
        <a
         target="_blank" rel="noopener noreferrer" href="https://api.whatsapp.com/send/?phone=593984287413&text=Hola%2C+me+gustar%C3%ADa+obtener+m%C3%A1s+informaci%C3%B3n.&type=phone_number&app_absent=0" class="btn btn-secondary"> Quiero un producto </a>
      </div>

    <div class="social-networks">
      <a href={FBURL} class="social-link social-icon-link" target="_blank" rel="noopener noreferrer">
        <img
          class="social-icon social-icon-facebook"
          src="/icon/icofb.webp"
          alt="Creditek en Facebook"
          width="1024"
          height="1024"
        />
      </a>

      <a href={INS} class="social-link social-icon-link" target="_blank" rel="noopener noreferrer">
        <img
          class="social-icon social-icon-instagram"
          src="/icon/icoinstagram.webp"
          alt="Creditek en Instagram"
          width="512"
          height="512"
        />
      </a>

      <a href={TIKTOK} class="social-link social-icon-link" target="_blank" rel="noopener noreferrer">
        <img
          class="social-icon social-icon-tiktok"
          src="/icon/tiktok.webp"
          alt="Creditek en TikTok"
          width="2000"
          height="2000"
        />
      </a>
    </div>
    </div>

    <!-- DERECHA -->
    <div class="hero-image">
      <img
        src="/Creditek/Principal.jpeg"
        alt="Mascota de Creditek "
        width="1280"
        height="853"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>

  <div class="wave">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
      <path
        fill="#ffffff"
        d="M0,64L80,58.7C160,53,320,43,480,48C640,53,800,75,960,80C1120,85,1280,75,1360,69.3L1440,64L1440,320L0,320Z"
      ></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    background: linear-gradient(135deg, #0f9d58, #ff8c00);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: auto;
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
    color: white;
  }

  .hero-text h1 {
    font-size: clamp(2.25rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .hero-text h1 span {
    color: #ffb703;
  }

  .subtitle {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    line-height: 1.5;
    max-width: 420px;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .btn {
    padding: 0.9rem 1.8rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: #ff8c00;
    color: white;
  }

  .btn-primary:hover {
    background: #e67600;
  }

  .btn-secondary {
    border: 2px solid white;
    color: white;
  }

  .btn-secondary:hover {
    background: white;
    color: #0f9d58;
  }

  .social-icons {
    display: flex;
    gap: 0.8rem;
  }

  .social-networks {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .social-icon-link {
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.2s ease;
  }

  .social-icon-link:hover {
    transform: scale(1.08);
  }

  .social-icon {
    flex: none;
    max-width: none;
  }

  .social-icon-facebook {
    width: 40px;
    height: 40px;
  }

  .social-icon-instagram {
    width: 84px;
    height: 84px;
  }

  .social-icon-tiktok {
    width: 67px;
    height: 67px;
  }

  .social {
    width: 38px;
    height: 38px;
    background: white;
    color: #333;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s;
  }

  .social:hover {
    transform: translateY(-3px);
  }

  .hero-image img {
    width: 100%;
    max-width: 500px;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  }

  .wave {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 100px;
  }

  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-text h1 {
      font-size: 2.5rem;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-image img {
      margin: auto;
    }
  }
</style>
